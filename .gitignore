# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# ---- backend (python) ----
backend/.venv/
.venv/
__pycache__/
*.pyc
.pytest_cache/

# generated artifacts (regenerate via `python backend/data/legit_generator.py`)
backend/data/legit_baseline.jsonl
backend/data/training_corpus.jsonl

# trained model binaries (rebuild via `make models`). The two serialized
# models below ARE committed so a fresh clone demos a working detector with
# zero build step; every other file under models/ stays ignored.
backend/models/*
!backend/models/.gitkeep
!backend/models/xgb_model.json
!backend/models/iforest_model.joblib


# Static export output
frontend/out/
